{
  "name": "@kooraseru/design",
  "version": "0.0.0",
  "description": "Kooraseru web design tokens, themes, components, and page styles",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kooraseru/Kooraseru.git",
    "directory": "design"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "CHANGELOG.md",
    "*.css",
    "themes/*.css",
    "patterns/*.css",
    "pages/*.css",
    "themes.toml"
  ],
