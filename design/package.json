    ".": "./core.css",
    "./core.css": "./core.css",
    "./home.css": "./home.css",
    "./service.css": "./service.css",
    "./components.css": "./components.css",
    "./foundation.css": "./foundation.css",
    "./reset.css": "./reset.css",
    "./themes/*": "./themes/*",
    "./patterns/*": "./patterns/*",
    "./pages/*": "./pages/*",
    "./themes.toml": "./themes.toml"
  }
}
