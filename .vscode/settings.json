{
  "luau-lsp.platform.type": "standard",
  "luau-lsp.require.fileAliases": {
    "@lune": "${workspaceFolder}/.luau-lsp/lune"
  },
  "luau-lsp.analyzeLuaFiles": false,
  "luau-lsp.sourcemap.enabled": false,
  "luau-lsp.completion.autocompleteEnd": true,
  "livePreview.serverRoot": ".heap/pages",
  "livePreview.defaultPreviewPath": "index.html",
  "explorer.excludeGitIgnore": false,
  "files.exclude": {
    "**/.heap": false
  }
}
