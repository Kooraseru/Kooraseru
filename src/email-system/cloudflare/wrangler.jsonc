{
  "name": "kooraseru-worker",
  "main": "contact.js",
  "compatibility_date": "2026-09-30",
  "workers_dev": false,
  "routes": [{ "pattern": "contact.kooraseru.com/*", "zone_name": "kooraseru.com" }],
  "ratelimits": [{
    "name": "CONTACT_RATE_LIMIT",
    "namespace_id": "1001",
    "simple": { "limit": 3, "period": 60 }
  }],
  "secrets": {
    "required": ["GMAIL_CLIENT_ID", "GMAIL_CLIENT_SECRET", "GMAIL_REFRESH_TOKEN", "GMAIL_EMAIL"]
  }
}
